{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Home","text":""},{"location":"#box-hill-institute-diploma","title":"\u6fb3\u6d32\u535a\u58eb\u5c71\u5b66\u9662\u6bd5\u4e1a\u8bc1\u6837\u5f0f\u6a21\u7248\uff08Box Hill Institute diploma\uff09\u7248\u9762\u5e03\u5c40\u4e0e\u7f8e\u5b66\u5206\u6790","text":"<p>\u5728\u8de8\u56fd\u6c42\u5b66\u3001\u8de8\u56fd\u5c31\u4e1a\u4ee5\u53ca\u5b66\u672f\u8ba4\u8bc1\u65e5\u76ca\u9891\u7e41\u7684\u4eca\u5929\uff0c\u6d77\u5916\u9662\u6821\u7684\u5b66\u5386\u5b66\u4f4d\u8bc1\u4e66\u4e0d\u4ec5\u662f\u5b66\u751f\u5b66\u672f\u6210\u5c31\u7684\u51ed\u8bc1\uff0c\u66f4\u662f\u5c55\u73b0\u5b66\u6821\u5386\u53f2\u5e95\u8574\u3001\u6559\u80b2\u54c1\u4f4d\u4e0e\u89c6\u89c9\u4f20\u8fbe\u8bbe\u8ba1\u6c34\u5e73\u7684\u91cd\u8981\u8f7d\u4f53\u3002\u4f5c\u4e3a\u6fb3\u5927\u5229\u4e9a\u7ef4\u591a\u5229\u4e9a\u5dde\u8457\u540d\u7684\u516c\u7acb\u6280\u672f\u4e0e\u7ee7\u7eed\u6559\u80b2\uff08TAFE\uff09\u4e0e\u9ad8\u7b49\u6559\u80b2\u673a\u6784\uff0c\u6fb3\u6d32\u535a\u58eb\u5c71\u5b66\u9662\uff08Box Hill Institute\uff09\u7684\u6bd5\u4e1a\u8bc1\u4e0e\u7ed3\u4e1a\u8bc1\u4e66\u8bbe\u8ba1\u56e0\u5176\u4e25\u8c28\u7684\u5de5\u4e1a\u6807\u51c6\u3001\u7ecf\u5178\u7684\u7248\u9762\u5e03\u5c40\u4ee5\u53ca\u7ec6\u817b\u7684\u9632\u4f2a\u7f8e\u5b66\uff0c\u5728\u82f1\u8054\u90a6\u6559\u80b2\u4f53\u7cfb\u4e2d\u5177\u6709\u6781\u9ad8\u7684\u4ee3\u8868\u6027\u3002</p> <p></p> <p>\u672c\u6587\u5c06\u4ece\u7248\u5f0f\u67b6\u6784\u3001\u8272\u5f69\u7f8e\u5b66\u3001\u5b57\u4f53\u4f20\u8fbe\u3001\u9632\u4f2a\u5fae\u89c2\u8bbe\u8ba1\u7b49\u591a\u4e2a\u7ef4\u5ea6\uff0c\u5bf9\u535a\u58eb\u5c71\u5b66\u9662\u7f51\u7edc\u5b89\u5168\u56db\u7ea7\u8bc1\u4e66\uff08Certificate IV in Cyber Security\uff09\u8fd9\u4e00\u7ecf\u5178\u6837\u5f0f\u7684\u7248\u9762\u5e03\u5c40\u4e0e\u7f8e\u5b66\u7279\u5f81\u8fdb\u884c\u6df1\u5ea6\u5256\u6790\uff0c\u63a2\u5bfb\u5176\u80cc\u540e\u6240\u8574\u542b\u7684\u5de5\u4e1a\u7f8e\u5b66\u4e0e\u73b0\u4ee3\u4e3b\u4e49\u8bbe\u8ba1\u539f\u5219\u3002</p>"},{"location":"#logo","title":"\u4e00\u3001 \u54c1\u724c\u5f62\u8c61\u7684\u89c6\u89c9\u951a\u5b9a\uff1aLogo\u4e0e\u9875\u7709\u7684\u9ec4\u91d1\u6bd4\u4f8b","text":"<p>\u5728\u4efb\u4f55\u73b0\u4ee3\u8bc1\u4e66\u8bbe\u8ba1\u4e2d\uff0c\u9876\u90e8\u7684\u54c1\u724c\u6807\u8bc6\uff08Logo\uff09\u90fd\u627f\u62c5\u7740\u201c\u7b2c\u4e00\u89c6\u89c9\u843d\u70b9\u201d\u7684\u91cd\u4efb\u3002\u535a\u58eb\u5c71\u5b66\u9662\u7684\u8bc1\u4e66\u5728\u9876\u90e8\u91c7\u7528\u4e86\u6807\u51c6\u7684\u5e73\u8861\u5bf9\u79f0\u4e0e\u8272\u5757\u5bf9\u6bd4\u8bbe\u8ba1\u3002</p>"},{"location":"#1","title":"1. \u6807\u5fd7\u6027\u7684\u9a6c\u5f62\u56fe\u817e\u4e0e\u8272\u5f69\u78b0\u649e","text":"<p>\u8bc1\u4e66\u9876\u90e8\u4e2d\u592e\u504f\u53f3\uff08\u6216\u5c45\u4e2d\uff09\u914d\u7f6e\u4e86\u535a\u58eb\u5c71\u5b66\u9662\u7684\u5b98\u65b9Logo\u3002\u8be5Logo\u7531\u6df1\u84dd\u8272\u7684\u9a8f\u9a6c\u526a\u5f71\u8272\u5757\u4e0e\u660e\u4eae\u7684\u82a5\u672b\u7eff/\u67d4\u548c\u9ec4\u5e95\u8272\u5757\u62fc\u63a5\u800c\u6210\u3002 *   \u6df1\u84dd\u8272\uff08Navy Blue\uff09\uff1a\u8c61\u5f81\u7740\u6559\u80b2\u7684\u4e25\u8c28\u3001\u5b66\u672f\u7684\u6743\u5a01\u4ee5\u53ca\u804c\u4e1a\u6559\u80b2\u7684\u4e13\u4e1a\u6027\u4e0e\u7a33\u91cd\u611f\u3002 *   \u9ec4\u8272/\u7eff\u8272\u8272\u5757\uff1a\u6253\u7834\u4e86\u4f20\u7edf\u5b66\u672f\u8bc1\u4e66\u7684\u6c89\u95f7\u611f\uff0c\u6ce8\u5165\u4e86\u6fb3\u5927\u5229\u4e9a\u7279\u6709\u7684\u73b0\u4ee3\u3001\u6d3b\u529b\u4e0e\u751f\u547d\u529b\u3002</p>"},{"location":"#2","title":"2. \u8d2f\u7a7f\u5f0f\u7684\u6df1\u84dd\u79e9\u5e8f\u7ebf","text":"<p>Logo\u4e0b\u65b9\u8bbe\u8ba1\u4e86\u4e00\u6761\u6781\u5177\u89c6\u89c9\u51b2\u51fb\u529b\u7684\u6df1\u84dd\u8272\u8d2f\u7a7f\u5f0f\u7c97\u6a2a\u7ebf\u3002\u8fd9\u6761\u7ebf\u5728\u7248\u9762\u4e2d\u8d77\u5230\u4e86\u201c\u5b9a\u6d77\u795e\u9488\u201d\u7684\u4f5c\u7528\u3002\u5b83\u4e0d\u4ec5\u5728\u7269\u7406\u7a7a\u95f4\u4e0a\u5c06\u9876\u90e8\u7684\u5b66\u6821\u54c1\u724c\u533a\u4e0e\u4e0b\u90e8\u7684\u8bc1\u4e66\u6838\u5fc3\u5185\u5bb9\u533a\u8fdb\u884c\u4e86\u5229\u843d\u7684\u5207\u5206\uff0c\u66f4\u5728\u5fc3\u7406\u5c42\u9762\u4e0a\u4e3a\u6574\u5f20\u8bc1\u4e66\u5960\u5b9a\u4e86\u5e84\u91cd\u3001\u73b0\u4ee3\u7684\u5de5\u4e1a\u79e9\u5e8f\u611f\u3002</p>"},{"location":"#_1","title":"\u4e8c\u3001 \u51e0\u4f55\u7f8e\u5b66\u7684\u9aa8\u67b6\uff1a\u80cc\u666f\u7f51\u683c\u4e0e\u51e0\u4f55\u7eb9\u6837\u7684\u73b0\u4ee3\u6f14\u7ece","text":"<p>\u8bb8\u591a\u4eba\u8bef\u4ee5\u4e3a\u8bc1\u4e66\u7684\u80cc\u666f\u53ea\u662f\u666e\u901a\u7684\u767d\u7eb8\uff0c\u4f46\u7ec6\u770b\u535a\u58eb\u5c71\u5b66\u9662\u7684\u8bc1\u4e66\u6a21\u677f\uff0c\u5176\u80cc\u666f\u4e2d\u6697\u85cf\u7740\u6781\u5176\u7cbe\u81f4\u7684\u51e0\u4f55\u5e95\u7eb9\uff08Guilloche Patterns Pattern\uff09\u3002</p>"},{"location":"#1_1","title":"1. \u8702\u7a9d\u516d\u8fb9\u5f62\u4e0e\u4e09\u89d2\u5f62\u7684\u590d\u5408\u6784\u578b","text":"<p>\u8be5\u8bc1\u4e66\u80cc\u666f\u91c7\u7528\u4e86\u7531\u6d45\u7070\u8272\u548c\u6781\u6de1\u84dd\u8272\u7ebf\u6761\u4ea4\u7ec7\u800c\u6210\u7684\u201c\u7c7b\u8702\u7a9d\u72b6\u201d\u516d\u8fb9\u5f62\u4e0e\u83f1\u5f62\u7f51\u683c\u3002\u8fd9\u79cd\u8bbe\u8ba1\u5728\u7f8e\u5b66\u548c\u529f\u80fd\u4e0a\u6709\u7740\u53cc\u91cd\u8003\u91cf\uff1a *   \u7a7a\u95f4\u62c9\u4f38\u611f\uff1a\u5fae\u7ec6\u7684\u51e0\u4f55\u7ebf\u6761\u8d4b\u4e88\u4e86\u6241\u5e73\u7684\u7eb8\u5f20\u4e00\u79cd\u7eb5\u6df1\u7684\u7acb\u4f53\u7a7a\u95f4\u611f\uff0c\u4f7f\u8bc1\u4e66\u6574\u4f53\u89c6\u89c9\u6548\u679c\u66f4\u52a0\u901a\u900f\u3001\u9ad8\u7ea7\u3002 *   \u4e0e\u4e13\u4e1a\u5951\u5408\u7684\u8bbe\u8ba1\u9690\u55bb\uff1a\u4ee5\u201cCyber Security\uff08\u7f51\u7edc\u5b89\u5168\uff09\u201d\u8bc1\u4e66\u4e3a\u4f8b\uff0c\u8fd9\u79cd\u7f51\u683c\u72b6\u3001\u7c7b\u4f3c\u5bc6\u5319\u6216\u8702\u5de2\u7684\u5b89\u5168\u67b6\u6784\u7eb9\u6837\uff0c\u5728\u89c6\u89c9\u4e0a\u5de7\u5999\u5730\u547c\u5e94\u4e86\u4fe1\u606f\u5316\u3001\u6570\u5b57\u5316\u4e0e\u7f51\u7edc\u9632\u62a4\u7684\u884c\u4e1a\u7279\u5f81\u3002</p>"},{"location":"#2_1","title":"2. \u6570\u5b66\u7f8e\u611f\u4e0e\u9632\u4f2a\u529f\u80fd\u7684\u7edf\u4e00","text":"<p>\u8fd9\u79cd\u5e95\u7eb9\u5c5e\u4e8e\u73b0\u4ee3\u9ad8\u7cbe\u5ea6\u6570\u5b57\u9632\u4f2a\u8bbe\u8ba1\u7684\u8303\u7574\u3002\u7ebf\u6761\u5bc6\u5ea6\u6781\u9ad8\u4e14\u8fc7\u6e21\u81ea\u7136\uff0c\u65e5\u5e38\u89c6\u89c9\u4e2d\u5b83\u4f5c\u4e3a\u201c\u6e29\u548c\u7684\u80cc\u666f\u201d\u5b58\u5728\uff0c\u4e0d\u55a7\u5bbe\u593a\u4e3b\uff1b\u800c\u5728\u9ad8\u7cbe\u5ea6\u626b\u63cf\u6216\u590d\u5370\u65f6\uff0c\u7531\u4e8e\u83ab\u5c14\u6761\u7eb9\uff08Moir\u00e9 pattern\uff09\u539f\u7406\uff0c\u4f1a\u5bfc\u81f4\u7eb9\u8def\u5931\u771f\uff0c\u4ece\u800c\u5728\u7f8e\u5b66\u6846\u67b6\u5185\u5929\u7136\u5730\u8fbe\u6210\u4e86\u9632\u4f2a\u6548\u679c\u3002</p>"},{"location":"#_2","title":"\u4e09\u3001 \u6587\u672c\u5c42\u7ea7\u4e0e\u5b57\u4f53\u4f20\u8fbe\uff1a\u53e4\u5178\u6b27\u5f0f\u4e0e\u73b0\u4ee3\u5de5\u4e1a\u7684\u4ea4\u878d","text":"<p>\u6587\u5b57\u662f\u8bc1\u4e66\u7684\u6838\u5fc3\u3002\u535a\u58eb\u5c71\u5b66\u9662\u8bc1\u4e66\u5728\u6587\u672c\u5e03\u5c40\u4e0a\u4e25\u683c\u9075\u5faa\u4e86\u897f\u6587\u7248\u5f0f\u8bbe\u8ba1\u7684\u7ecf\u5178\u91d1\u5b57\u5854\u5c42\u7ea7\u7ed3\u6784\uff0c\u901a\u8fc7\u5b57\u4f53\u7684\u7c97\u7ec6\u3001\u5927\u5c0f\u548c\u5b57\u8ddd\u53d8\u5316\uff0c\u5b9e\u73b0\u4e86\u6781\u4f73\u7684\u9605\u8bfb\u6d41\u7545\u5ea6\u3002</p> \u6587\u672c\u5c42\u7ea7 \u5b57\u4f53\u98ce\u683c\u4e0e\u7f8e\u5b66\u7279\u5f81 \u89c6\u89c9\u610f\u56fe\u4e0e\u5fc3\u7406\u6697\u793a \u7b2c\u4e00\u5c42\uff1a\u8ba4\u8bc1\u5f15\u8a00 (This is to certify that...) \u4f18\u96c5\u7684\u610f\u5927\u5229\u659c\u4f53\uff08Italic\uff09\u6216\u82b1\u4f53\u886c\u7ebf\u5b57\u3002 \u627f\u88ad\u82f1\u8054\u90a6\u53e4\u8001\u5b66\u672f\u4f20\u7edf\u7684\u4eea\u5f0f\u611f\uff0c\u8bed\u6c14\u6e29\u548c\u800c\u575a\u5b9a\u3002 \u7b2c\u4e8c\u5c42\uff1a\u88ab\u6388\u52cb\u8005\u59d3\u540d (Student Name) \u653e\u5927\u3001\u52a0\u7c97\u7684\u7ecf\u5178\u9ed1\u4f53\u6216\u5927\u5199\u886c\u7ebf\u4f53\u3002 \u89c6\u89c9\u7126\u70b9\uff0c\u5f70\u663e\u5bf9\u6bd5\u4e1a\u751f\u4e2a\u4f53\u6210\u5c31\u7684\u6700\u9ad8\u5c0a\u91cd\u3002 \u7b2c\u4e09\u5c42\uff1a\u6838\u5fc3\u5b66\u4f4d/\u8bc1\u4e66\u540d\u79f0 (Certificate IV in Cyber Security) \u521a\u52b2\u6709\u529b\u7684\u7c97\u886c\u7ebf\u4f53\uff08Serif\uff09\uff0c\u5b57\u5f62\u9971\u6ee1\u3002 \u7a81\u51fa\u6838\u5fc3\u542b\u91d1\u91cf\uff0c\u5c55\u73b0\u4e13\u4e1a\u8d44\u8d28\u7684\u6743\u5a01\u6027\u4e0e\u4e0d\u53ef\u52a8\u6447\u6027\u3002 \u7b2c\u56db\u5c42\uff1a\u8bfe\u7a0b\u4ee3\u7801\u4e0e\u6846\u67b6\u8bf4\u660e (Course Code &amp; AQF) \u6807\u51c6\u7684\u73b0\u4ee3\u65e0\u886c\u7ebf\u4f53\uff08Sans-serif\uff09\u6216\u5e38\u89c4\u5c0f\u5b57\u3002 \u6ee1\u8db3\u5de5\u4e1a\u4e0e\u6cd5\u5f8b\u89c4\u8303\uff0c\u786e\u4fdd\u4fe1\u606f\u68c0\u7d22\u7684\u5b9e\u7528\u6027\u3002 <p>\u8fd9\u79cd\u201c\u659c\u4f53\u5f15\u5165 \u2192 \u7c97\u4f53\u59d3\u540d \u2192 \u7a33\u91cd\u5b66\u4f4d \u2192 \u89c4\u8303\u5c0f\u5b57\u201d\u7684\u6d41\u52a8\u89c6\u7ebf\uff0c\u4f53\u73b0\u4e86\u6781\u4e3a\u9ad8\u8d85\u7684\u6392\u7248\u529f\u5e95\u3002\u6587\u5b57\u56db\u5468\u7559\u51fa\u4e86\u5927\u91cf\u7684\u201c\u8d1f\u7a7a\u95f4\u201d\uff08White Space\uff09\uff0c\u4f7f\u5f97\u6574\u5f20\u7eb8\u9762\u867d\u7136\u627f\u8f7d\u4e86\u5927\u91cf\u4fe1\u606f\uff0c\u5374\u4f9d\u7136\u663e\u5f97\u9ad8\u8d35\u3001\u5178\u96c5\u3001\u4e0d\u62e5\u6324\u3002</p>"},{"location":"#_3","title":"\u56db\u3001 \u8bc1\u4e66\u5e95\u90e8\u7684\u5e73\u8861\u7f8e\u5b66\uff1a\u5370\u7ae0\u3001\u7b7e\u540d\u4e0e\u56fd\u5bb6\u8ba4\u8bc1\u7684\u94c1\u4e09\u89d2","text":"<p>\u8bc1\u4e66\u7684\u5e95\u90e8\u662f\u6574\u5f20\u8bc1\u4e66\u7684\u201c\u4fe1\u4efb\u80cc\u4e66\u533a\u201d\u3002\u535a\u58eb\u5c71\u5b66\u9662\u91c7\u7528\u4e86\u5b8c\u7f8e\u7684\u4e09\u70b9\u5f0f\u5bf9\u79f0\u5e73\u8861\u5e03\u5c40\uff0c\u5c06\u6cd5\u5f8b\u6548\u529b\u4e0e\u89c6\u89c9\u7f8e\u5b66\u878d\u4e3a\u4e00\u4f53\u3002</p>"},{"location":"#1-embossed-seal","title":"1. \u94a2\u5370\uff08Embossed Seal\uff09\u7684\u53e4\u5178\u538b\u8f74","text":"<p>\u4f4d\u4e8e\u5de6\u4e0b\u89d2\u7684\u662f\u4e00\u679a\u6df1\u8910\u7ea2\u8272\u7684\u9f7f\u8f6e\u72b6\u9f7f\u8fb9\u94a2\u5370\u3002\u94a2\u5370\u662f\u897f\u65b9\u4f20\u7edf\u4e2d\u4ee3\u8868\u201c\u6700\u9ad8\u6388\u6743\u201d\u4e0e\u201c\u6cd5\u5f8b\u5951\u7ea6\u201d\u7684\u89c6\u89c9\u7b26\u53f7\u3002\u7acb\u4f53\u51f9\u51f8\u7684\u8d28\u611f\u4e0d\u4ec5\u5728\u89e6\u89c9\u4e0a\u4e30\u5bcc\u4e86\u8bc1\u4e66\u7684\u5c42\u6b21\uff0c\u5176\u6c89\u7a33\u7684\u8272\u8c03\u66f4\u5728\u5de6\u4e0b\u89d2\u538b\u4f4f\u4e86\u6574\u5f20\u8bc1\u4e66\u7684\u89c6\u89c9\u91cd\u5fc3\uff0c\u4e0e\u9876\u90e8\u7684\u6df1\u84dd\u6a2a\u7ebf\u5f62\u6210\u4e86\u8de8\u8d8a\u7eb8\u9762\u7684\u8272\u5f69\u547c\u5e94\u3002</p>"},{"location":"#2_2","title":"2. \u8463\u4e8b\u4f1a\u53cc\u7b7e\u540d\u7684\u5e73\u8861\u5bf9\u79f0","text":"<p>\u4e2d\u592e\u504f\u4e0b\u4f4d\u7f6e\u914d\u7f6e\u4e86\u201cBOARD CHAIR\uff08\u8463\u4e8b\u4f1a\u4e3b\u5e2d\uff09\u201d\u4e0e\u201cBOARD SECRETARY\uff08\u8463\u4e8b\u4f1a\u79d8\u4e66\uff09\u201d\u7684\u624b\u5199\u7b7e\u540d\u3002\u624b\u5199\u7b7e\u540d\u7684\u7075\u52a8\u7ebf\u6761\u6253\u7834\u4e86\u4e0a\u65b9\u5370\u5237\u5b57\u4f53\u7684\u5446\u677f\uff0c\u4e24\u7ec4\u7b7e\u540d\u5e73\u884c\u6392\u5217\uff0c\u5b57\u5f62\u957f\u77ed\u4e0e\u95f4\u8ddd\u7ecf\u8fc7\u7cbe\u5fc3\u5fae\u8c03\uff0c\u8fbe\u6210\u4e86\u6c34\u5e73\u89c6\u7ebf\u4e0a\u7684\u7edd\u5bf9\u5e73\u8861\u3002</p>"},{"location":"#3","title":"3. \u201c\u6fb3\u5927\u5229\u4e9a\u56fd\u5bb6\u8ba4\u53ef\u57f9\u8bad\u201d\u6807\u5fd7\u7684\u5f69\u8272\u70b9\u7f00","text":"<p>\u53f3\u4e0b\u89d2\u662f\u4e00\u7ec4\u6781\u5177\u8fa8\u8bc6\u5ea6\u7684\u201cNationally Recognised Training\uff08NRT\uff09\u201d\u6e10\u53d8\u8272\u5012\u4e09\u89d2\u5f62\u6761\u7eb9\u6807\u5fd7\u3002 *   \u8272\u5f69\u9012\u53d8\uff1a\u7531\u7ea2\u5230\u7eff\u3001\u518d\u5230\u6df1\u84dd\u7684\u6a2a\u5411\u6761\u7eb9\u4ea4\u7ec7\u51fa\u4e00\u79cd\u5411\u4e0b\u7684\u7bad\u5934\u52a8\u611f\u3002 *   \u653f\u6cbb\u4e0e\u5b66\u672f\u5408\u89c4\u6027\uff1a\u8be5\u6807\u5fd7\u4ee3\u8868\u8be5\u8bc1\u4e66\u5b8c\u5168\u7eb3\u5165\u4e86\u6fb3\u5927\u5229\u4e9a\u8d44\u683c\u6846\u67b6\uff08AQF\uff09\u4f53\u7cfb\uff0c\u5728\u5168\u6fb3\u4e43\u81f3\u82f1\u8054\u90a6\u8303\u56f4\u5185\u83b7\u5f97\u5e7f\u6cdb\u627f\u8ba4\u3002\u5728\u7f8e\u5b66\u4e0a\uff0c\u8fd9\u4e2a\u73b0\u4ee3\u611f\u5341\u8db3\u7684\u5f69\u6761\u6807\u5fd7\u4e0e\u5de6\u4fa7\u7684\u53e4\u5178\u94a2\u5370\u5f62\u6210\u4e86\u201c\u4e00\u5de6\u4e00\u53f3\u3001\u4e00\u53e4\u4e00\u4eca\u201d\u7684\u7edd\u5999\u89c6\u89c9\u4e92\u8865\u3002</p>"},{"location":"#_4","title":"\u4e94\u3001 \u603b\u7ed3\uff1a\u4ece\u5de5\u4e1a\u6807\u51c6\u5316\u8d70\u5411\u73b0\u4ee3\u8bbe\u8ba1\u7f8e\u5b66","text":"<p>\u900f\u89c6\u6fb3\u6d32\u535a\u58eb\u5c71\u5b66\u9662\u7684\u6bd5\u4e1a\u8bc1\u6837\u5f0f\u6a21\u677f\uff0c\u6211\u4eec\u53ef\u4ee5\u6e05\u6670\u5730\u770b\u5230\u5305\u8c6a\u65af\u201c\u529f\u80fd\u51b3\u5b9a\u5f62\u5f0f\u201d\u8bbe\u8ba1\u7406\u5ff5\u7684\u5ef6\u4f38\u3002\u5b83\u6452\u5f03\u4e86\u4e2d\u4e16\u7eaa\u8fc7\u4e8e\u7e41\u590d\u3001\u5197\u4f59\u7684\u5df4\u6d1b\u514b\u5f0f\u82b1\u8fb9\uff0c\u8f6c\u800c\u91c7\u7528\u5e72\u7ec3\u7684\u8d2f\u7a7f\u7ebf\u6761\u3001\u4e25\u5bc6\u7684\u73b0\u4ee3\u51e0\u4f55\u5e95\u7eb9\u3001\u9ad8\u5bf9\u6bd4\u5ea6\u7684\u8272\u5f69\u5757\u9762\u4ee5\u53ca\u4e25\u8c28\u7684\u897f\u6587\u5b57\u4f53\u5c42\u7ea7\u3002</p> <p>\u8fd9\u79cd\u8bbe\u8ba1\u65e2\u4fdd\u7559\u4e86\u82f1\u8054\u90a6\u5b66\u672f\u5708\u6240\u5fc5\u9700\u7684\u5e84\u91cd\u3001\u4e25\u8083\u4e0e\u4eea\u5f0f\u611f\uff0c\u53c8\u5145\u5206\u8003\u8651\u4e86\u73b0\u4ee3\u5de5\u4e1a\u793e\u4f1a\u5bf9\u4fe1\u606f\u9ad8\u53ef\u8bfb\u6027\u3001\u9632\u4f2a\u9ad8\u6280\u672f\u6027\u7684\u73b0\u5b9e\u9700\u6c42\u3002\u535a\u58eb\u5c71\u5b66\u9662\u6bd5\u4e1a\u8bc1\u4e66\u7684\u7248\u9762\u5e03\u5c40\uff0c\u65e0\u7591\u662f\u73b0\u4ee3\u5e73\u9762\u8bbe\u8ba1\u4e2d\u5c06\u5b9e\u7528\u4e3b\u4e49\u3001\u5b66\u672f\u6743\u5a01\u4e0e\u89c6\u89c9\u7f8e\u5b66\u5b8c\u7f8e\u7ed3\u5408\u7684\u6770\u51fa\u5178\u8303\u3002</p>"}]}